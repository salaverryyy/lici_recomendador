DB_HOST=localhost
DB_PORT=5432
DB_NAME=interfaz_lici
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_TU_CONTRASENA_LOCAL
# En producción, definir DATABASE_URL en Vercel con la URL de un PostgreSQL alojado.
# Si DATABASE_URL existe, tiene prioridad sobre DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD.
# Cuando se conecte un proveedor de correo, configurar estas variables solo en .env o Vercel:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# FRONTEND_URL=https://TU_DOMINIO

# Fotos/fichas: local en desarrollo; s3 para almacenamiento persistente externo.
MEDIA_STORAGE=local
# MEDIA_PUBLIC_URL=https://ARCHIVOS.TU_DOMINIO
# S3_BUCKET=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# Asistente IA. Crear la clave en Google AI Studio y guardarla solo en el backend.
# Nunca usar un nombre VITE_* para este secreto.
# GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=25
# Límite preventivo por instancia e IP para proteger el nivel gratuito.
AI_REQUESTS_PER_10_MINUTES=10
